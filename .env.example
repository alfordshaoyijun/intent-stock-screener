# Optional AI backend for natural-language intent framing.
# Default: auto-detect Codex CLI; if unavailable, AI is disabled and rules still work.

# AI_BACKEND=codex-cli
# CODEX_BIN=C:\Users\you\AppData\Local\OpenAI\Codex\bin\codex.exe
# CODEX_MODEL=
# CODEX_REASONING_EFFORT=low

# OpenAI-compatible local servers, such as Ollama or LM Studio.
# AI_BACKEND=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:7b
# AI_API_KEY=not-needed

# Disable AI explicitly.
# AI_BACKEND=none

# Server configuration (set environment variables before npm start).
# PORT=5173
# STOCK_POOL_LIMIT=200
# STRATEGY_STORE_PATH=/persistent/strategies.json
# IFIND_CALL_MODULE=/private/ifind-finance-data/call-node.js
# The authorized Skill and its credentials must be provisioned separately.
# .env files are not automatically loaded by npm start.
# Protected temporary demo only. No account isolation; all reviewers share one store.
# DEMO_ACCESS_USER=demo
# DEMO_ACCESS_PASSWORD=generate-a-long-random-password
